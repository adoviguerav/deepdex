{
  "name": "deepdex",
  "version": "0.2.4",
  "description": "Pokémon-themed deep work app for macOS",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "test": "TZ=Europe/Madrid vitest run"
  },
  "build": {
    "appId": "com.adolfo.deepdex",
    "productName": "DeepDex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "DeepDex cierra las apps de tu lista negra mientras dura una sesión de foco."
      }
    },
    "afterPack": "build/afterPack.cjs",
    "dmg": {
      "artifactName": "DeepDex-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
